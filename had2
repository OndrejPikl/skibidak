import pygame
import random
import sqlite3
from datetime import datetime

# =====================================================
# ------------------ DATABÁZE -------------------------
# =====================================================

def init_db():
    conn = sqlite3.connect("snake_scores.db")
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS highscores (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            player_name TEXT,
            score INTEGER,
            date TEXT
        )
    """)
    conn.commit()
    conn.close()


def save_score(name, score):
    if not name:
        name = "Anonym"

    conn = sqlite3.connect("snake_scores.db")
    cursor = conn.cursor()
    datum = datetime.now().strftime("%d.%m.%Y %H:%M")

    cursor.execute(
        "INSERT INTO highscores (player_name, score, date) VALUES (?, ?, ?)",
        (name, score, datum)
    )

    conn.commit()
    conn.close()


def get_top_scores():
    conn = sqlite3.connect("snake_scores.db")
    cursor = conn.cursor()

    cursor.execute(
        "SELECT player_name, score FROM highscores ORDER BY score DESC LIMIT 5"
    )

    data = cursor.fetchall()
    conn.close()
    return data


init_db()

# =====================================================
# ------------------ PYGAME ---------------------------
# =====================================================

pygame.init()

WIDTH, HEIGHT = 1000, 800
CELL = 40
FPS = 60

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Smooth Snake PRO")
clock = pygame.time.Clock()

# Barvy
BG1 = (170, 215, 81)
BG2 = (162, 209, 73)
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)

# =====================================================
# ------------------ TEXTURY --------------------------
# =====================================================

def load(name):
    img = pygame.image.load(name).convert_alpha()
    return pygame.transform.scale(img, (CELL, CELL))

HEAD = load("hlava_hada.png")
BODY = load("tělo_hada.png")
TAIL = load("tail.png")
TURN = load("turn.png")
APPLE = load("jablko_had.png")
TONGUE = load("tongue.png")

# =====================================================
# ------------------ GRID -----------------------------
# =====================================================

def draw_grid():
    for y in range(0, HEIGHT, CELL):
        for x in range(0, WIDTH, CELL):
            color = BG1 if (x//CELL + y//CELL) % 2 == 0 else BG2
            pygame.draw.rect(screen, color, (x, y, CELL, CELL))

# =====================================================
# ------------------ JÍDLO ----------------------------
# =====================================================

def spawn_food(snake):
    while True:
        pos = (
            random.randint(0, WIDTH//CELL-1)*CELL,
            random.randint(0, HEIGHT//CELL-1)*CELL
        )
        if pos not in snake:
            return pos

# =====================================================
# ------------------ SMĚRY ----------------------------
# =====================================================

UP = (0,-1)
DOWN = (0,1)
LEFT = (-1,0)
RIGHT = (1,0)

def angle_from_dir(d):
    return {RIGHT:0, LEFT:180, UP:90, DOWN:-90}[d]

# =====================================================
# ------------------ VYKRESLOVÁNÍ ---------------------
# =====================================================

def draw_head(pos, direction):
    ang = angle_from_dir(direction)
    rotated = pygame.transform.rotate(HEAD, ang)
    rect = rotated.get_rect(center=(pos[0]+CELL//2, pos[1]+CELL//2))
    screen.blit(rotated, rect.topleft)


def draw_tail(tail, before):
    dx = before[0]-tail[0]
    dy = before[1]-tail[1]
    dir_tail = (dx//CELL, dy//CELL)
    ang = angle_from_dir(dir_tail)
    rotated = pygame.transform.rotate(TAIL, ang)
    rect = rotated.get_rect(center=(tail[0]+CELL//2, tail[1]+CELL//2))
    screen.blit(rotated, rect.topleft)


def draw_body_segment(prev, curr, nxt):
    dx1 = prev[0]-curr[0]
    dy1 = prev[1]-curr[1]
    dx2 = nxt[0]-curr[0]
    dy2 = nxt[1]-curr[1]

    if dx1==dx2 or dy1==dy2:
        if dx1 != 0:
            angle = 0
        else:
            angle = 90
        seg_img = pygame.transform.rotate(BODY, angle)
    else:
        seg_img = pygame.transform.rotate(TURN, 0)

    rect = seg_img.get_rect(center=(curr[0]+CELL//2, curr[1]+CELL//2))
    screen.blit(seg_img, rect.topleft)

# =====================================================
# ------------------ GAME OVER ------------------------
# =====================================================

def game_over(score, player_name):

    save_score(player_name, score)
    top_scores = get_top_scores()

    font_big = pygame.font.SysFont("Arial", 50)
    font_small = pygame.font.SysFont("Arial", 30)

    while True:
        screen.fill(BLACK)

        screen.blit(font_big.render("GAME OVER", True, (255,0,0)),
                    (WIDTH//2-150,150))

        screen.blit(font_small.render(f"Hráč: {player_name}", True, WHITE),
                    (WIDTH//2-120,250))

        screen.blit(font_small.render(f"Skóre: {score}", True, WHITE),
                    (WIDTH//2-100,300))

        screen.blit(font_small.render("TOP 5:", True, (255,255,0)),
                    (WIDTH//2-60,380))

        for i, (name, s) in enumerate(top_scores):
            text = f"{i+1}. {name} - {s}"
            screen.blit(font_small.render(text, True, (0,255,0)),
                        (WIDTH//2-100, 430 + i*40))

        screen.blit(font_small.render("R - Restart | Q - Quit",
                                      True, WHITE),
                    (WIDTH//2-150,700))

        pygame.display.flip()

        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit()
                exit()
            if e.type == pygame.KEYDOWN:
                if e.key == pygame.K_q:
                    pygame.quit()
                    exit()
                if e.key == pygame.K_r:
                    return

# =====================================================
# ------------------ HRA ------------------------------
# =====================================================

def game(player_name):

    snake = [(400,400),(360,400),(320,400)]
    direction = RIGHT
    last_dir = direction
    food = spawn_food(snake)
    score = 0

    move_delay = 120
    last_move = pygame.time.get_ticks()

    while True:

        dt = clock.tick(FPS)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                exit()

        keys = pygame.key.get_pressed()
        if keys[pygame.K_UP] and last_dir != DOWN: direction = UP
        if keys[pygame.K_DOWN] and last_dir != UP: direction = DOWN
        if keys[pygame.K_LEFT] and last_dir != RIGHT: direction = LEFT
        if keys[pygame.K_RIGHT] and last_dir != LEFT: direction = RIGHT

        if pygame.time.get_ticks() - last_move > move_delay:
            last_move = pygame.time.get_ticks()

            new_head = (snake[0][0]+direction[0]*CELL,
                        snake[0][1]+direction[1]*CELL)

            if (new_head[0]<0 or new_head[1]<0 or
                new_head[0]>=WIDTH or new_head[1]>=HEIGHT or
                new_head in snake):

                game_over(score, player_name)
                return

            snake.insert(0,new_head)
            last_dir = direction

            if new_head == food:
                score += 1
                move_delay = max(60, move_delay-3)
                food = spawn_food(snake)
            else:
                snake.pop()

        draw_grid()
        screen.blit(APPLE, food)

        for i in range(1, len(snake)-1):
            draw_body_segment(snake[i-1], snake[i], snake[i+1])

        if len(snake) > 1:
            draw_tail(snake[-1], snake[-2])

        draw_head(snake[0], direction)

        font = pygame.font.SysFont("Arial",30)
        screen.blit(font.render(f"Score: {score}", True, WHITE), (10,10))

        pygame.display.flip()

# =====================================================
# ------------------ MENU -----------------------------
# =====================================================

def menu():

    font = pygame.font.SysFont("Arial",50)
    small = pygame.font.SysFont("Arial",30)

    player_name = ""

    while True:

        screen.fill((0,0,0))

        screen.blit(font.render("SNAKE guta",True,WHITE),
                    (WIDTH//2-140,200))

        screen.blit(small.render("Zadej jméno:",True,WHITE),
                    (WIDTH//2-100,300))

        pygame.draw.rect(screen, WHITE,
                         (WIDTH//2-150,350,300,50),2)

        screen.blit(small.render(player_name + "|",
                                 True,(255,255,0)),
                    (WIDTH//2-130,360))

        screen.blit(small.render("ENTER - Play",
                                 True,WHITE),
                    (WIDTH//2-80,450))

        pygame.display.flip()

        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                pygame.quit()
                exit()

            if e.type == pygame.KEYDOWN:

                if e.key == pygame.K_RETURN:
                    if player_name.strip() != "":
                        game(player_name)
                        player_name = ""

                elif e.key == pygame.K_BACKSPACE:
                    player_name = player_name[:-1]

                else:
                    if len(player_name) < 12:
                        player_name += e.unicode


menu()
