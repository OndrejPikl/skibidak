def init_db():
    conn = sqlite3.connect("snake_scores.db")
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS highscores (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            player_name TEXT,
            score INTEGER,
            date TEXT
        )
    ''')
    conn.commit()
    conn.close()

def save_score(name, score):
    conn = sqlite3.connect("snake_scores.db")
    cursor = conn.cursor()
    datum = datetime.now().strftime("%d.%m.%Y %H:%M")
    cursor.execute("INSERT INTO highscores (player_name, score, date) VALUES (?, ?, ?)", 
                   (name, score, datum))
    conn.commit()
    conn.close()

init_db()

